root = true

# end_of_line is deliberately not set. The repository stores LF and Git
# converts on checkout (core.autocrlf), so a fixed value here would fight
# Git on Windows. Prettier uses endOfLine "auto" for the same reason.

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Ruff format: four spaces.
[*.py]
indent_size = 4

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
