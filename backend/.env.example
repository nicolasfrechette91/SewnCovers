# Owner: FastAPI server. Optional; defaults to development at process runtime.
# Allowed values: development, test, production.
ENVIRONMENT=development

# Owner: FastAPI server. Optional locally; required when ENVIRONMENT=production.
# Local origin: http://localhost:3000
# Production Pages origin: https://nicolasfrechette91.github.io
# Format: one exact HTTP(S) origin without credentials, path, query, or fragment.
FRONTEND_ORIGIN=http://localhost:3000

# Owner: production Uvicorn process. Optional; defaults to 8000.
# Hosting platforms may provide this process variable automatically.
# Valid range: 1-65535.
PORT=8000

# Owner: FastAPI server. Optional at startup; required only for database operations.
# Locally, use only the Neon development branch value in ignored backend/.env.
# Require SSL in the URL. Supply privately; never commit or expose a real value.
DATABASE_URL=

# Custom uploads are opt-in and remain disabled on the deployed service.
# Local deterministic workflow: keep filesystem storage outside public/static
# trees and explicitly select a development-only moderation result.
CUSTOM_UPLOADS_ENABLED=false
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ROOT=.local/custom-assets

# Production placeholders for a private S3-compatible service. Leave empty
# locally. Bucket names, keys, and endpoints are server-only and must never use
# NEXT_PUBLIC_ variables or be committed with real values.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Allowed: none, development-approve, development-reject, openai.
# Development outcomes are rejected when ENVIRONMENT=production. Production
# uploads require openai plus a protected key and remain fail-closed otherwise.
MODERATION_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-2024-09-26

# Authentication requires no signing secret: sessions and project shares use
# random opaque bearer tokens and persist only SHA-256 token hashes in the
# configured database. Password hashing parameters and seven-day session expiry
# are reviewed application constants, not environment secrets.
