{
  "name": "sewncovers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:config": "node --test config/environment.test.mjs",
    "test": "node --test config/environment.test.mjs services/api-client.test.mjs services/design-save.test.mjs services/pattern-catalogue.test.mjs services/phase-6-integration.test.mjs services/shared-design.test.mjs && tsx --import ./tests/setup-dom.mjs --test tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "node e2e/run-playwright.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:export": "node config/verify-static-export.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "26.1.0",
    "tailwindcss": "^4",
    "tsx": "4.20.3",
    "typescript": "^5"
  }
}
