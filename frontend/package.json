{
  "name": "sewncovers",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:config": "tsx --test \"config/*.test.mjs\"",
    "test": "npm run test:node && npm run test:dom",
    "test:node": "tsx --test \"config/*.test.mjs\" \"services/*.test.mjs\"",
    "test:dom": "tsx --import ./tests/setup-dom.mjs --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "test:e2e": "node e2e/run-playwright.mjs",
    "screenshots:readme": "node scripts/readme-screenshots.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:export": "node config/verify-static-export.mjs",
    "verify:performance": "node config/verify-performance-budget.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "tsx": "4.20.3",
    "typescript": "^5"
  }
}
