# Secrets and local configuration (the .env.example files stay tracked)
.env
.env.*
!.env.example

# Frontend build output and caches (frontend/.gitignore covers the rest)
node_modules/
/frontend/.next/
/frontend/out/
/frontend/.playwright/
*.tsbuildinfo
next-env.d.ts

# Backend: virtualenv, caches, local SQLite databases and upload storage
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
*.sqlite3*
/backend/.local/

# Logs
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local-only review notes
/docs/IMPROVEMENT_REVIEW.md
